<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- English texts that depend on a count (so "1 entry", not "1 entries"). -->
<plist version="1.0">
<dict>
	<key>%lld entries</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@entries@</string>
		<key>entries</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld entry</string>
			<key>other</key>
			<string>%lld entries</string>
		</dict>
	</dict>
	<key>The folder and the %lld entries inside it are removed from Hoatzin. Saved Keychain passwords are kept.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@folder@</string>
		<key>folder</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>The folder and the entry inside it are removed from Hoatzin. Saved Keychain passwords are kept.</string>
			<key>other</key>
			<string>The folder and the %lld entries inside it are removed from Hoatzin. Saved Keychain passwords are kept.</string>
		</dict>
	</dict>
</dict>
</plist>
